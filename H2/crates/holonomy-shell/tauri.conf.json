{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holonomy",
  "version": "0.1.0",
  "identifier": "dev.holonomy.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev:tauri",
    "devUrl": "http://localhost:5184",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Holonomy",
        "width": 1280,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: holo-asset:; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A word processor for very long documents",
    "longDescription": "Holonomy keeps a 2000-page document responsive by rendering only the sections near the caret, with the scroll geometry resolved in Rust over a Fenwick tree of section heights.",
    "fileAssociations": [
      {
        "ext": [
          "holo"
        ],
        "name": "Holonomy document",
        "description": "A Holonomy word processor document",
        "role": "Editor",
        "mimeType": "application/vnd.holonomy.document"
      }
    ]
  }
}
